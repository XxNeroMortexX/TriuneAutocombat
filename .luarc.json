{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT"
  },
  "workspace": {
    "library": [
      // MQ type definitions (https://github.com/macroquest/mq-definitions)
      // cloned next to this repo; the mq-defs VS Code extension adds its own copy.
      "../mq-definitions"
    ]
  },
  "diagnostics": {
    "globals": [
      "ImGuiCond",
      "ImGuiCol",
      "ImGuiStyleVar",
      "ImGuiTableFlags",
      "ImGuiTableColumnFlags",
      "ImGuiSelectableFlags",
      "ImGuiWindowFlags",
      "ImVec2",
      "ImVec4",
      "IM_COL32",
      "bit",
      "clearCursor",
      "DATA"
    ],
    "disable": [
      "undefined-field", // MQ's type definitions are incomplete (imgui, TLO)
      "param-type-mismatch", // Same as above
      "cast-local-type" // Same as above
    ]
  }
}
